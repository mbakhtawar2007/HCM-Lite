# Frontend environment variables. Copy this file to .env if you need one.
#
# Leave VITE_API_URL empty in development: Vite proxies /api to
# http://localhost:5000 (see vite.config.js).
# In production, set it to your deployed backend, e.g.:
# VITE_API_URL=https://your-api.onrender.com/api
VITE_API_URL=
