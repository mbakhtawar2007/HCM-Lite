# Copy this file to .env and fill in your own values. Never commit .env.
# Server
PORT=5000
NODE_ENV=development

# Database — local MongoDB, or a free MongoDB Atlas cluster (see README).
MONGO_URI=mongodb://127.0.0.1:27017/hackathon-boilerplate

# Auth — generate a long random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# Changing this invalidates every existing login token.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (comma-separated if you have more than one).
CLIENT_URL=http://localhost:5173
