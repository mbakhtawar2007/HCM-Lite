# Copy this file to .env and fill in your own values. Never commit .env.
# Server
PORT=5000
NODE_ENV=development

# Database — local MongoDB, or a free MongoDB Atlas cluster (see README).
# NOTE: on networks whose DNS refuses SRV lookups, use the non-SRV form
# (list the shard hosts, ssl=true, replicaSet=..., authSource=admin)
# instead of mongodb+srv:// — see README "Database setup".
MONGO_URI=mongodb://127.0.0.1:27017/hcm-lite

# Auth — generate a long random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# Changing this invalidates every existing login token.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (comma-separated if several).
CLIENT_URL=http://localhost:5173

# First-run setup auto-seed (optional). If both are set and no user
# exists yet, the server creates the first ADMIN on startup.
# Prefer the /setup page instead when a human is doing first-run setup.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
# COMPANY_NAME=HCM Lite

# AI assistant (P3). Backend only — never put this key in the
# frontend, in chat, or in any committed file. For local runs, put your
# own key in backend/.env; for the deployed backend, enter it yourself
# in the hosting provider's environment settings (e.g. Vercel project
# settings) and redeploy. Without it, AI routes return a friendly 503
# and the rest of the app works normally.
# AI_API_KEY=
# OpenAI-compatible provider endpoint. Default is Groq's free tier
# (no card required, key from console.groq.com).
# AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# Default model: openai/gpt-oss-120b (Groq free tier; llama-3.3-70b
# is no longer on Groq's free/developer plans). Change only if your
# provider's model list changes.
# AI_MODEL=openai/gpt-oss-120b
# Max AI requests per user per hour, counted from AiLog rows (works
# across serverless instances). Default 20.
# AI_RATE_LIMIT_PER_HOUR=20
