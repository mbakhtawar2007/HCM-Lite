# Copy this file to .env and fill in your own values. Never commit .env.
# Server
PORT=5000
NODE_ENV=development

# Database — local MongoDB, or a free MongoDB Atlas cluster (see README).
# NOTE: on networks whose DNS refuses SRV lookups, use the non-SRV form
# (list the shard hosts, ssl=true, replicaSet=..., authSource=admin)
# instead of mongodb+srv:// — see README "Database setup".
MONGO_URI=mongodb://127.0.0.1:27017/hcm-lite

# Auth — generate a long random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# Changing this invalidates every existing login token.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (comma-separated if several).
CLIENT_URL=http://localhost:5173

# First-run setup auto-seed (optional). If both are set and no user
# exists yet, the server creates the first ADMIN on startup.
# Prefer the /setup page instead when a human is doing first-run setup.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
# COMPANY_NAME=HCM Lite

# AI assistant (P3 — set later, P3).
# The browser never calls the AI provider; this key is backend-only.
# AI_API_KEY=
